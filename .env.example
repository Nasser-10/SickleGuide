# ============================================================
# SickleGuide Environment Configuration
# ============================================================
# Copy this file to .env before running the backend:
#   cp .env.example .env
#
# Never commit your real .env or API secrets.

# -----------------------------
# LLM / Ollama
# -----------------------------
# SickleGuide currently uses Ollama through LangChain.
# Make sure Ollama is running and the selected model is installed.
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=1200

# -----------------------------
# Embeddings / Reranking
# -----------------------------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# -----------------------------
# Persistent data
# -----------------------------
CHROMA_PATH=./data/processed/chroma
CHUNKS_PATH=./data/processed/chunks.json
GRAPH_PATH=./data/processed/graph.json
RAW_DATA_PATH=./data/raw

# -----------------------------
# Retrieval
# -----------------------------
DENSE_K=15
BM25_K=15
GRAPH_K=15
CANDIDATE_K=20
FINAL_K=5
MAX_GROUNDING_RETRIES=1

# -----------------------------
# API
# -----------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------
# Frontend
# -----------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
